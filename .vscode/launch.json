{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Whacker",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/whacker",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "GLFW_PLATFORM", "value": "x11" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Whacker"
        }
    ]
}
